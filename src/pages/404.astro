---
import Base from '../layouts/Base.astro';
import { t } from '../i18n';
const d = t('cs');
---

<Base lang="cs" noindex>
  <main class="nf">
    <a class="logo" href="/" style="justify-self:center"><b style="font-size:2rem">Pension <i style="color:var(--amber);font-style:normal">48</i></b></a>
    <h1>{d.notFound.h}</h1>
    <p>{d.notFound.p}</p>
    <p><a class="btn" href="/">{d.notFound.back}</a></p>
  </main>
</Base>
