---
import '@fontsource-variable/figtree/wght.css';
import '@fontsource-variable/bricolage-grotesque/wght.css';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { site, langs, withBase, isStaging, type Lang } from '../config/site';
import { t } from '../i18n';
import { pricing } from '../config/pricing';

interface Props {
  lang: Lang;
  noindex?: boolean;
}
const { lang, noindex: noindexProp = false } = Astro.props;
const noindex = noindexProp || isStaging();
const d = t(lang);
const canonical = new URL(withBase(langs[lang].path), site.url).href;
const og = new URL(withBase('/og.jpg'), site.url).href;

const photoModules = import.meta.glob<{ default: ImageMetadata }>('/src/assets/photos/*.jpg', { eager: true });
const imgs = (
  await Promise.all(
    ['zima-dum', 'leto-dum', 'pokoj-dvoululkovy', 'spolecenska-mistnost'].map(async (n) => {
      const src = photoModules[`/src/assets/photos/${n}.jpg`].default;
      const g = await getImage({ src, width: Math.min(1024, src.width), format: 'webp' });
      return new URL(g.src, site.url).href;
    }),
  )
);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'LodgingBusiness',
  '@id': site.url + '/#pension',
  name: site.name,
  description: d.meta.description,
  url: canonical,
  image: [og, ...imgs],
  hasMap: site.mapy,
  availableLanguage: ['cs', 'en', 'de'],
  sameAs: Object.values(site.reviewLinks).filter((u) => u.startsWith('http')),
  telephone: [site.phone1, site.phone2].map((p) => p.replace(/\s/g, '')),
  email: site.email,
  priceRange: `${pricing.summer.min}–${pricing.winter.max} CZK`,
  currenciesAccepted: 'CZK',
  petsAllowed: true,
  inLanguage: d.lang,
  numberOfRooms: 5,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.street,
    postalCode: site.zip.replace(' ', ''),
    addressLocality: site.city,
    addressCountry: 'CZ',
  },
  geo: { '@type': 'GeoCoordinates', latitude: site.lat, longitude: site.lon },
  amenityFeature: ['Wi-Fi', 'Free parking', 'Shared kitchen', 'Ski storage'].map((n) => ({
    '@type': 'LocationFeatureSpecification',
    name: n,
    value: true,
  })),
  makesOffer: [
    { name: d.prices.winter, ...pricing.winter },
    { name: d.prices.summer, ...pricing.summer },
  ].map((o) => ({
    '@type': 'Offer',
    name: o.name,
    priceCurrency: 'CZK',
    priceSpecification: {
      '@type': 'PriceSpecification',
      minPrice: o.min,
      maxPrice: o.max,
      priceCurrency: 'CZK',
      unitText: 'per person per night',
    },
  })),
  founder: { '@type': 'Person', name: site.operator },
  taxID: site.ico,
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{d.meta.title}</title>
    <meta name="description" content={d.meta.description} />
    {noindex ? <meta name="robots" content="noindex" /> : <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1" />}
    <link rel="canonical" href={canonical} />
    {
      !noindex &&
        (Object.keys(langs) as Lang[]).map((l) => (
          <link rel="alternate" hreflang={langs[l].hreflang} href={new URL(withBase(langs[l].path), site.url).href} />
        ))
    }
    {!noindex && <link rel="alternate" hreflang="x-default" href={new URL(withBase('/'), site.url).href} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={d.meta.title} />
    <meta property="og:description" content={d.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={d.hero.alt} />
    <meta property="og:locale" content={d.ogLocale} />
    {(Object.keys(langs) as Lang[]).filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={t(l).ogLocale} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={d.meta.title} />
    <meta name="twitter:description" content={d.meta.description} />
    <meta name="twitter:image" content={og} />
    <meta name="theme-color" content="#14203a" />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={withBase('/favicon.ico')} sizes="32x32" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body>
    <slot />
  </body>
</html>
